          ProgressionMode: {
             BeforeYouBegin: Zanim zaczniesz...
             AskEnable: Czy chcesz włączyć listę kontrolną progresji?
             SelectAnOption: Wybierz opcję poniżej...
             SelectDisable:
                '''
                Kontynuuj z wyłączoną listą kontrolną progresji...
                * Cała zawartość stron jest odblokowana od początku
                * Nic nie jest ukryte. Brak ograniczeń.
                '''
             SelectEnable:
                '''
                Kontynuuj z w pełni włączoną listą kontrolną progresji...
                * Zawartość stron jest zablokowana dla niepokonanych wpisów
                * Portrety i imiona są zamaskowane
                * Łupy z bossów są zablokowane do momentu pokonania wpisu
                * Włączono sprawdzanie następnego elementu, co ogranicza limity informacji (zalecane)
                '''
             SelectConfig: Zamknij Dziennik Bossów i skonfiguruj listę kontrolną progresji...
             DisablePrompt: Nie pokazuj ponownie tego komunikatu
             Description: Lista kontrolna progresji ograniczy i ukryje zawartość wpisów do momentu pokonania bosa lub oznaczenia go jako ukończonego. Jeśli planujesz grę w ciemno, warto rozważyć włączenie tej funkcji. Dziennik Bossów jest wyłączony, dopóki nie dokonasz wyboru lub nie otworzysz go ponownie z wyłączonym monitem konfiguracji.
             IsEnabled:
                '''
                [i:888] Lista kontrolna progresji jest w pełni lub częściowo włączona!
                Zamaskuje to niektóre informacje o bossach, dopóki nie zostaną pokonane.
                Aby wyłączyć lub skonfigurować listę kontrolną progresji, przejdź do:
                Ustawienia > Konfiguracja modów > Dostosowanie Dziennika Bossów: Dziennik Bossów
                i przewiń w dół do opcji trybu progresji
                '''
          }

          HintTexts: {
             MarkEntry: Kliknij prawym przyciskiem myszy na wpis, aby oznaczyć go jako pokonany
             HideEntry: Kliknij lewym przyciskiem myszy na wpis, aby ukryć go z listy kontrolnej
             ClearMarked: Przytrzymaj ALT i kliknij prawym przyciskiem myszy ten przycisk, aby wyczyścić wszystkie oznaczone wpisy
             ClearHidden: Przytrzymaj ALT i kliknij prawym przyciskiem myszy ten przycisk, aby wyczyścić wszystkie ukryte wpisy
             ClearItems: Przytrzymaj ALT i kliknij prawym przyciskiem myszy ten przycisk, aby oznaczyć wymienione przedmioty jako niezdobyte
             RemoveItem: Przytrzymaj ALT i kliknij prawym przyciskiem myszy na przedmiot, aby oznaczyć go jako niezdobyty
             ClearAllRecords: Przytrzymaj ALT i kliknij prawym przyciskiem myszy ten przycisk, aby zresetować wartości rekordów listy
             ClearRecord: Przytrzymaj ALT i kliknij prawym przyciskiem myszy ikonę rekordu, aby zresetować jego wartość
          }
       }

