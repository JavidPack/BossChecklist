			}

			Tabs: {
				ToggleFilters: Cambiar filtros
				TableOfContents: Índice
				Credits: Créditos
				NextEntry:
					'''
					Siguiente {0}:
					{1}
					'''
				Records: Récords
				SpawnInfo: Invocación
				LootAndCollectibles: Botín y coleccionables
			}

			Indicator: {
				ProgressionMode: El modo de progresión está {0}
				ManualChecklist: Las entradas se marcan manualmente
				AutomaticChecklist: La lista marca entradas automáticamente
				OnlyBossContentEnabled: Solo se muestra contenido de jefes
				OnlyBossContentDisabled: Se muestra todo el contenido
