Mods: {
	BossChecklist: {
		Log: {
			Common: {
				BossLog: Registro de jefes
				Entry: Entrada
				Boss: Jefe
				BossPlural: Jefes
				MiniBoss: Minijefe
				MiniBossPlural: Minijefes
				Event: Evento
