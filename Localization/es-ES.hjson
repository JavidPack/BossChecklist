			EntryPage: {
				Defeated: Derrotado en {0}{1}
				Undefeated: No derrotado en {0}
				CopyKey:
					'''
					Clic para copiar la 'clave de entrada' al portapapeles
					{0}
					'''
				ViewPage: Clic para ver la página
				NotImplemented: La página no está disponible. El mod no la ha enviado o está mal configurada.
				LogFeaturesNotAvailable: Récords, objetos de invocación y botín desactivados. El mod no envió datos suficientes o está mal configurado.
			}

			Records: {
				NewRecord: ¡Nuevo récord personal!
				NewWorldRecord: ¡Récord del mundo!
				NoRecord: Sin récord
				Unchallenged: ¡Sin enfrentar!
				KDR: "{0} bajas / {1} muertes"
				TotalKills: Bajas totales
				Hours: "{0}h {1}m {2}s ({3}ms)"
				Minutes: "{0}m {1}s ({2}ms)"
				Seconds: "{0} segundo{^0:;s} ({1}ms)"
				NoHit: ¡Sin golpes!
				Hit: "{0} {^0:golpe;golpes}"
				PreviousBest: Tu mejor anterior
				ClaimRecord: ¡Sé el primero en el récord del mundo!
				RecordHolder: Poseedor(es) del récord

				Category: {
					PreviousAttempt: Intento anterior
					FirstVictory: Primera victoria
					PersonalBest: Mejor personal
					WorldRecord: Récords del mundo
					Cycle: Cambiar categoría de récords
