				Tooltip: {
					Duration: ¡El tiempo más rápido en derrotar a este jefe!
					HitsTaken: ¡Evita ataques! Intenta derrotarlo sin recibir daño.
					PreviousAttempt: ¡Veces totales que has enfrentado a este jefe!
					PersonalBest: ¡Veces que mataste a este jefe y que él te mató!
					FirstVictory: ¡Tiempo de juego hasta la primera victoria!
					WorldRecord: ¡Bajas y muertes globales de todos los jugadores!
				}
			}

			SpawnInfo: {
				NoInfo: Sin información
				RecipeFrom: Receta de: {0}
				CycleRecipe: Cambiar receta alternativa
				Noncraftable: Este objeto no se puede crear
				NoSpawnItem: Este {0} no tiene objeto de invocación
				ByHand: A mano
			}

			LootAndCollection: {
				MaskedItems: Derrota esta entrada para ver botín y coleccionables
				ItemIsExpertOnly: Solo se obtiene en modo Experto
				ItemIsMasterOnly: Solo se obtiene en modo Maestro
				ItemIsLocked: Este objeto tiene requisitos especiales
				Obtained: ¡Objeto obtenido!
				Researched: ¡Objeto investigado!
			}

			ProgressionMode: {
				BeforeYouBegin: Antes de empezar...
				AskEnable: ¿Quieres activar la lista de progresión?
				SelectAnOption: Elige una opción...
				SelectDisable:
					'''
					Continuar con la lista de progresión desactivada...
					* Toda la info de páginas desbloqueada al inicio
					* Nada oculto. Sin límites.
					'''
				SelectEnable:
					'''
					Continuar con la lista de progresión activada...
					* Info bloqueada en entradas no derrotadas
					* Retratos y nombres ocultos
					* Botín bloqueado hasta derrotar
					* Siguiente jefe activo (recomendado)
					'''
				SelectConfig: Cierra el registro y configura la lista de progresión...
				DisablePrompt: No volver a mostrar este aviso
				Description: La lista de progresión oculta el contenido de las entradas hasta derrotarlas o marcarlas. Ideal para una partida a ciegas. El registro está desactivado hasta que elijas o lo reabras con el aviso desactivado.
				IsEnabled:
					'''
					[i:888] ¡La lista de progresión está total o parcialmente activada!
					Ocultará info de jefes hasta derrotarlos.
					Para desactivar o configurar ve a:
					Ajustes > Config. de mods > Boss Checklist: Personalizar registro de jefes
					y baja a las configs de modo de progresión
					'''
			}

			HintTexts: {
				MarkEntry: Clic derecho en una entrada para marcarla como derrotada
				HideEntry: Clic izquierdo en una entrada para ocultarla de la lista
				ClearMarked: Mantén ALT y clic derecho para borrar todas las marcadas
				ClearHidden: Mantén ALT y clic derecho para borrar todas las ocultas
				ClearItems: Mantén ALT y clic derecho para marcar objetos como no obtenidos
				RemoveItem: Mantén ALT y clic derecho en un objeto para marcarlo no obtenido
				ClearAllRecords: Mantén ALT y clic derecho para reiniciar los récords
				ClearRecord: Mantén ALT y clic derecho en el icono de un récord para reiniciarlo
			}
		}

