Mods: {
	BossChecklist: {
		Log: {
			Common: {
				BossLog: Journal des Boss
				Entry: Entrée
				Boss: Boss
				BossPlural: Bosses
				MiniBoss: Mini-boss
				MiniBossPlural: Mini-boss
				Event: Événement
				EventPlural: Événements
				Enabled: activé
				Disabled: désactivé
				PartiallyEnabled: partiellement activé
			}

			Tabs: {
				ToggleFilters: Activer/désactiver les filtres
				TableOfContents: Table des matières
				Credits: Crédits
				NextEntry:
					'''
					{0} suivant :
					{1}
					'''
				Records: Enregistrements
				SpawnInfo: Informations sur le spawn
				LootAndCollectibles: Butin et objets collectables
			}

			Indicator: {
				ProgressionMode: Le mode de progression est {0}
				ManualChecklist: Les entrées doivent être cochées manuellement par l'utilisateur
				AutomaticChecklist: La liste de contrôle cochera automatiquement les entrées
				OnlyBossContentEnabled: Seul le contenu du boss peut être affiché
				OnlyBossContentDisabled: Tout le contenu disponible peut être affiché
			}

			TableOfContents: {
				PreHardmode: Pre-Hardmode
				Hardmode: Hardmode
				ProgressBarListMods: Cliquer pour passer en mode Liste des mods
				ProgressBarListTypes: Cliquer pour passer en mode Type d'entrée
				AllLoot: Tous les butins du boss obtenus!
				AllDropLoot: Tous les butins du boss non collectables obtenus!
				AllCollectibles: Tous les objets collectables du boss obtenus!

				Filter: {
					Show: "{0} : Afficher"
					Hide: "{0} : Masquer"
					HideWhenCompleted: "{0} : Caché après la victoire"
					ToggleHiddenOpen: Ouvrir la liste masquée
					ToggleHiddenClose: Confirmer et fermer la liste masquée
					Disabled: Filtre désactivé en raison de la configuration "Afficher uniquement le contenu du boss"
				}
			}

			Credits: {
				Devs: Contributeurs
				Mods: Mods enregistrés
				Notice: "[La liste ne contient que les mods chargés]"
				NoIcon: Icône de mod non trouvée!
				ModsEmpty: Aucun de vos mods chargés n'est enregistré!
				Register: Enregistrez votre propre mod !
				Learn: Voir la description du mod pour savoir comment procéder.

				Titles: {
					// Owner: Creator & Owner
					// CoOwner: Co-Owner & Maintainer
					// Contributor: Code Contributor
					// Sprites: Boss Log Sprites
					// EarlyTesting: Early Testing
				}
			}

			EntryPage: {
				Defeated: Vaincu en {0}
				Undefeated: Invaincu en {0}
				CopyKey: Cliquer pour copier l'ID interne du Boss dans le presse-papiers
				ViewPage: Cliquer pour voir la page
				NotImplemented: L'affichage de cette page n'est pas disponible. Le mod n'a pas soumis de page ou l'a mal configurée.
				LogFeaturesNotAvailable: Les entrées, les objets d'invocation et le tableau de butin de cette page sont désactivés. Le mod n'a pas fourni suffisamment d'informations pour la page ou l'a mal configuré.
			}

			Records: {
				NewRecord: Nouveau record personnel!
				NewWorldRecord: Nouveau record du monde!
				NoRecord: Aucun record
				Unchallenged: Invaincu
				// KDR: "{0} kills / {1} deaths"
				// TotalKills: Total kills
				Hours: "{0}h {1}m {2}s ({3}ms)"
				Minutes: "{0}m {1}s ({2}ms)"
				Seconds: "{0} second{^0:e;es} ({1}ms)"
				NoHit: Aucun dommage!
				Hit: "{0} dommag{^0:e;es}"
				PreviousBest: Précédent meilleur résultat
				ClaimRecord: Soyez le premier à établir un record du monde!
				RecordHolder: Détenteur(s) du record

				Category: {
					PreviousAttempt: Tentative précédente
					FirstVictory: Première victoire
					PersonalBest: Record personnel
					WorldRecord: Records du monde
					Cycle: Changer de catégorie d'enregistrement
				}

				Title: {
					PreviousAttempt: Tentative
					FirstVictory: Temps de jeu
					PersonalBest: Ratio tué/mort
					WorldRecord: Global KDR
					Duration: Durée du combat
					DurationWorld: Combat le plus rapide
					HitsTaken: Coups reçus
					HitsTakenWorld: Min. de coups reçus
				}

				Tooltip: {
					Duration: Le temps le plus rapide pour vaincre ce boss!
					HitsTaken: Évitez autant d'attaques que possible! Essayez de vaincre ce boss sans subir de dégâts!
					PreviousAttempt: Nombre total de fois que vous avez rencontré ce boss!
					PersonalBest: Nombre total de fois où vous avez tué ce boss et nombre total de fois où ce boss vous a tué!
					FirstVictory: Temps total de jeu pendant lequel votre personnage a été actif, jusqu'à la mort du premier boss !
					WorldRecord: Éliminations et décès globaux de tous les joueurs pour ce boss!
				}
			}

			SpawnInfo: {
				NoInfo: Aucune information disponible
				RecipeFrom: Recette de : {0}
				CycleRecipe: Recettes alternatives
				Noncraftable: Cet objet ne peut pas être fabriqué
				NoSpawnItem: Ce {0} n'a pas d'objet d'invocation
				ByHand: Manuellement
			}

			LootAndCollection: {
				MaskedItems: Battez cette cible pour voir son butin et ses objets de collection
				ItemIsExpertOnly: Cet objet n'est disponible qu'en mode Expert
				ItemIsMasterOnly: Cet objet n'est disponible qu'en mode Master
				ItemIsLocked: Cet objet a des exigences spéciales pour être débloqué
				Obtained: Cet objet a été obtenu!
				Researched: Cet article a déjà fait l'objet de recherches!
			}

			ProgressionMode: {
				BeforeYouBegin: Avant de commencer...
				AskEnable: Voulez-vous activer le mode progression ? ?
				SelectAnOption: Veuillez sélectionner une option ci-dessous...
				SelectDisable:
					'''
					Continuer avec le mode progression désactivé...
					* Tout le contenu des informations de la page est déverrouillé dès le début
					* Rien de caché. Aucune limite.
					'''
				SelectEnable:
					'''
					Continuer avec mode progression entièrement activé...
					* Le contenu des informations de la page est verrouillé pour les entrées invaincues
					* Les portraits et les noms sont masqués
					* Butin du boss verrouillé jusqu'à sa défaite
					* Vérification suivante activée, réduisant les limitations d'informations (recommandé)
					'''
				SelectConfig: Fermez le Journal des Boss et configurez le mode progression...
				DisablePrompt: Ne plus afficher cette demande
				Description:
					'''
					Le mode Progression masque certains contenus de boss jusqu'à ce que vous les vainquiez ou remplissiez certaines conditions.
					Cette fonctionnalité est particulièrement utile pour les joueurs qui souhaitent jouer au jeu au toucher, sans connaître à l'avance tous les boss et leurs fonctionnalités.

					Veuillez noter que le Boss Magazine sera désactivé jusqu'à ce que vous sélectionniez l'une des options!
					'''
				IsEnabled:
					'''
					[i:888] Le mode Progression est entièrement ou partiellement activé!
					Il cache certaines informations sur les boss jusqu'à ce qu'ils soient vaincus.
					Pour désactiver ou configurer le mode progression, accédez à:
					Paramètres > Paramètres du module > Boss Checklist > Boss Log Customization
					et faites défiler jusqu'aux paramètres du mode de progression
					'''
			}

			HintTexts: {
				MarkEntry: Cliquez droit sur une entrée pour la marquer comme annulée
				HideEntry: Cliquez gauche sur une entrée pour la masquer de la liste
				ClearMarked: ALT + clic droit sur ce bouton pour effacer toutes les entrées marquées
				ClearHidden: ALT + clic droit sur ce bouton pour effacer toutes les entrées masquées
				ClearItems: ALT + clic droit sur ce bouton pour marquer les éléments répertoriés comme non obtenus
				RemoveItem: ALT + clic droit sur un élément pour le marquer comme non obtenu
				ClearAllRecords: ALT + clic droit sur ce bouton pour réinitialiser les valeurs des records
				ClearRecord: ALT + clic droit sur l'icône d'un record pour le réinitialiser
			}
		}

		Checklist: {
