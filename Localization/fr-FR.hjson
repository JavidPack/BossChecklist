				ColoredBossText: {
					// Label: Colored Boss Text
					/* Tooltip:
						'''
						The boss text in the table of contents will be green when defeated and red when not.
						If next check is enabled, the next boss will be yellow.
						''' */
				}

				SelectedCheckmarkType: {
					// Label: Checklist Marking Type
					// Tooltip: ""
				}

				DrawNextMark: {
					// Label: Next Boss Check
					// Tooltip: Puts a circle in the checkbox to indicate it is the next undefeated boss to fight.
				}

				LootChecklist: {
					// Label: Enable loot/collectible checklist
					// Tooltip: The table of contents will also check if you've obtained all of a boss's loot and collectible items.
				}

				CheckDroppedLoot: {
					// Label: Only check droppable loot
					// Tooltip: Items that are not dropped by the entry, such as music boxes, will not be counted towards the loot check.
				}

				EnableProgressionMode: {
					// Label: Enable Progression Mode
					// Tooltip: ""
				}

				DisableProgressionMode: {
					// Label: Disable Progression Mode
					// Tooltip: ""
				}

				MaskTextures: {
					// Label: Hide textures until entry is defeated
					// Tooltip: ""
				}

				MaskNames: {
					// Label: Hide names until entry is defeated
					// Tooltip: ""
				}

				UnmaskNextCheck: {
					// Label: Show the name of the next entry to fight
					// Tooltip: Note that the Next Boss Check AND Hide Boss Names must be enabled for this to work.
				}

				MaskBossLoot: {
					// Label: Hide boss drops until entry is defeated
					// Tooltip: ""
				}

				MaskHardMode: {
					// Label: Hide hardmode content until in hardmode
					// Tooltip: Hides ALL content, overriding the options you have toggled above.
				}

				ShowProgressBars: {
					// Label: Show Progress Bars
					// Tooltip: When disabled, the total progress bars at the bottom of the table of contents will not show.
				}
			}

			DebugTools: {
				// Tooltip: ""

				ModCallLogVerbose: {
					// Label: Mod.Call Log Verbose
					/* Tooltip:
						'''
						If true, logs will display more information on entry data creation within tModLoader logs.
						Invalid or incorrect usage of mod calls are displayed regardless of setting.
						''' */
				}

				DisableAutoLocalization: {
					// Label: Disable Auto Localization
					/* Tooltip:
						'''
						BossChecklist will detect old calls and create localizations for LocalizedText submissions needed for the new calls.
						The new calls do not require these localizations but will default to them if null is passed.
						Set to true to prevent new localizations from being created by BossChecklist.
						''' */
				}

				EnabledResetOptions: {
					// Label: Enable Reset Data Options
					/* Tooltip:
						'''
						When enabled, your are able to clear or reset certain data within the Boss Log.
						Includes: Clearing hidden entries, clearing marked entries, clearing loot checklist, and resetting records.
						[c/FF0000:The 'Enable Interactions Tab' config is required in order to use this config.]
						''' */
				}

				ShowProgressionValue: {
					// Label: Access Progression Values
					/* Tooltip:
						'''
						Shows the progression value when hovering over an entry within the table of contents and when viewing an entry's page.
						The progression value is what determines how entries are ordered in the checklist.
						''' */
				}

				AccessInternalNames: {
					// Label: Access Entry Keys
					/* Tooltip:
						'''
						Adds a button on each entry page that displays and copies the Entry Key to the in-game clipboard.
						Useful for mod developers making cross-mod content.
						''' */
				}

				ShowCollectionType: {
					// Label: Show Auto-detected Collectible Type
					// Tooltip: Boss collectible itemslots will be labeled with the assigned collectible type.
				}

				InactiveBossCheck: {
					// Label: Inactive Boss Check
					/* Tooltip:
						'''
						While enabled, a message will be displayed in chat when records have begun calculating, if record tracking is enabled.
						This should also display a message in chat when a despawn message appears, if despawn messages are enabled.
						These messages should appear when a boss has been defeated or a boss has despawned, respectively.
						''' */
				}
			}

			FeatureConfiguration: {
				// DisplayName: Other features

				Headers: {
					// BossRadar: "[i:3084] [c/ffeb6e:Boss Radar]"
					// ChatMessages: "[i:3037] [c/ffeb6e:Chat Messages]"
					// ItemMapDetection: "[i:893] [c/ffeb6e:Item Map Detection]"
					// BossRecords: "[i:3095] [c/ffeb6e:Boss Records]"
				}

				RecordTrackingEnabled: {
					// Label: Enable Boss Record Tracking
					// Tooltip: When enabled, fight stats will be tracked for records.
				}

				AllowNewRecords: {
					// Label: Allow New Records
					/* Tooltip:
						'''
						When disabled, only your previous attempt is recorded.
						First victory and personal best records will not be overwritten.
						''' */
				}

				NewRecordLogGlow: {
					// Label: Enable New Record Log Glow
					/* Tooltip:
						'''
						When enabled, setting a new record will put a rainbow glow on the following:
						- Boss Log button
						- Table of Contents entry name
						''' */
				}

				TimeValueFormat: {
					// Label: Time Value Format
					/* Tooltip:
						'''
						Standard: [0:00:00.000]
						Simple: [0h 0m 0s 0ms]
						''' */
				}

				DisplayRecordTracking: {
					// Label: Display Record Tracker Values
					/* Tooltip:
						'''
						When enabled, record tracking values are shown and updated during a boss fight.
						Note: Strictly for singleplayer, currently. Does not work in multiplayer.
						''' */
				}

				DespawnMessageType: {
					// Label: Boss Despawn Annoucements
					/* Tooltip:
						'''
						Despawn messages will appear in chat when a boss becomes inactive.
						If enabled, choose between generic or unique messages.
						''' */
				}

				LimbMessages: {
					// Label: Non-Boss Defeated Annoucements
					/* Tooltip:
						'''
						Messages will appear in chat when an important component of an entry is defeated.
						Examples include: Skeletron's Hands, Retinazor/Spazmatism, the Celestial Pillars, etc.
						''' */
				}

				MoonMessages: {
					// Label: Moon Event Ending Annoucements
					/* Tooltip:
						'''
						Messages will appear in chat when a vanilla moon event has ended.
						Moon events include: Blood Moon, Eclipse, Pumpkin Moon and Frost Moon.
						''' */
				}

				TimerSounds: {
					// Label: Respawn Timer Sounds
					// Tooltip: If enabled, the last 3 seconds of your respawn time will have sound indicators.
				}

				TreasureBagsOnMap: {
					// Label: Treasure bags display on the map
					// Tooltip: ""
				}

				FragmentsOnMap: {
					// Label: Fragments display on the map
					// Tooltip: ""
				}

				ScalesOnMap: {
					// Label: Shadow Scales and Tissue Samples display on the map
					// Tooltip: ""
				}

				EnableBossRadar: {
					// Label: Enable Boss Radar
					// Tooltip: ""
				}

				RadarMiniBosses: {
					// Label: Whitelist mini bosses
					// Tooltip: Note: This only works properly with mini bosses that have head icons.
				}

				RadarOpacity: {
					// Label: Radar Opacity
					// Tooltip: Adjust how transparent the radar's icon will be.
				}

				RadarBlacklist: {
					// Label: Radar Blacklist
					// Tooltip: The selected NPCs will not be tracked by the radar.
				}
			}
		}
	}
}
