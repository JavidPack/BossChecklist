					'''
					Suivant {0} :
					{1}
					'''
				Records: Enregistrements
				SpawnInfo: Informations sur le spawn
				LootAndCollectibles: Butin et objets collectables
			}

			Indicator: {
				ProgressionMode: Le mode de progression est {0}
				ManualChecklist: Les entrées doivent être cochées manuellement par l'utilisateur
				AutomaticChecklist: La liste de contrôle cochera automatiquement les entrées
				OnlyBossContentEnabled: Seul le contenu du boss peut être affiché
				OnlyBossContentDisabled: Tout le contenu disponible peut être affiché
			}

			TableOfContents: {
				PreHardmode: Pre-Hardmode
				Hardmode: Hardmode
				ProgressBarListMods: Cliquer pour passer en mode Liste des mods
				ProgressBarListTypes: Cliquer pour passer en mode Type d'entrée
				AllLoot: Tous les butins du boss obtenus!
				AllDropLoot: Tous les butins du boss non collectables obtenus!
				AllCollectibles: Tous les objets collectables du boss obtenus!

				Filter: {
					Show: "{0} : Afficher"
					Hide: "{0} : Masquer"
					HideWhenCompleted: "{0} : Caché après la victoire"
					ToggleHiddenOpen: Ouvrir la liste masquée
					ToggleHiddenClose: Confirmer et fermer la liste masquée
					Disabled: Filtre désactivé en raison de la configuration "Afficher uniquement le contenu du boss"
				}
			}

			Credits: {
				Devs: Contributeurs
				Mods: Mods enregistrés
				Notice: "[La liste ne contient que les mods chargés]"
				NoIcon: Icône de mod non trouvée!
				ModsEmpty: Aucun de vos mods chargés n'est enregistré!
				Register: Enregistrez votre propre mod !
				Learn: Voir la description du mod pour savoir comment procéder.
			}

			EntryPage: {
				Defeated: Vaincu en {0}
				Undefeated: Invaincu en {0}
				CopyKey: Cliquer pour copier l'ID interne du Boss dans le presse-papiers
				CopySource: Cliquer pour copier la source du mod dans le presse-papiers
				ViewPage: Cliquer pour voir la page
				NotImplemented: L'affichage de cette page n'est pas disponible. Le mod n'a pas soumis de page ou l'a mal configurée.
				LogFeaturesNotAvailable: Les entrées, les objets d'invocation et le tableau de butin de cette page sont désactivés. Le mod n'a pas fourni suffisamment d'informations pour la page ou l'a mal configuré.
			}

			Records: {
				NewRecord: Nouveau record personnel!
				NewWorldRecord: Nouveau record du monde!
				NoRecord: Aucun record
				Unchallenged: Invaincu
				Kills: Eliminations
				Deaths: Décès
				Total: Total
				NoHit: Aucun dommage!
				Hit: dommage
				HitPlural: dommages
				PreviousBest: Précédent meilleur résultat
				ClaimRecord: Soyez le premier à établir un record du monde!
				RecordHolder: Détenteur(s) du record

				Category: {
					PreviousAttempt: Tentative précédente
					FirstVictory: Première victoire
					PersonalBest: Record personnel
					WorldRecord: Records du monde
					Cycle: Changer de catégorie d'enregistrement
