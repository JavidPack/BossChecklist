Mods: {
	BossChecklist: {
		Log: {
			Common: {
				BossLog: Journal des Boss
				Entry: Entrée
				Boss: Boss
				BossPlural: Bosses
				MiniBoss: Mini-boss
				MiniBossPlural: Mini-boss
				Event: Événement
				EventPlural: Événements
				Enabled: activé
				Disabled: désactivé
				PartiallyEnabled: partiellement activé
			}

			Tabs: {
				ToggleFilters: Activer/désactiver les filtres
				TableOfContents: Table des matières
				Credits: Crédits
